{
  "name": "vscode-debugger-mcp",
  "displayName": "VSCode Debugger MCP",
  "description": "将当前活动的 VSCode 调试器暴露为本地 MCP Server，供 AI 编程助手进行 attach/断点/单步/变量查看等辅助调试",
  "version": "1.0.0",
  "publisher": "vscode-debugger-mcp",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Debuggers", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscodeDebuggerMcp.showStatus",
        "title": "VSCode Debugger MCP: 操作菜单"
      },
      {
        "command": "vscodeDebuggerMcp.startServer",
        "title": "VSCode Debugger MCP: 开始 MCP 服务"
      },
      {
        "command": "vscodeDebuggerMcp.stopServer",
        "title": "VSCode Debugger MCP: 停止 MCP 服务"
      },
      {
        "command": "vscodeDebuggerMcp.restartServer",
        "title": "VSCode Debugger MCP: 重启 MCP 服务"
      },
      {
        "command": "vscodeDebuggerMcp.changePort",
        "title": "VSCode Debugger MCP: 修改端口"
      }
    ],
    "configuration": {
      "title": "VSCode Debugger MCP",
      "properties": {
        "vscodeDebuggerMcp.port": {
          "type": "number",
          "default": 37643,
          "minimum": 1024,
          "maximum": 65535,
          "description": "MCP 服务监听端口"
        },
        "vscodeDebuggerMcp.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "扩展激活时自动启动 MCP 服务"
        },
        "vscodeDebuggerMcp.useBroker": {
          "type": "boolean",
          "default": true,
          "description": "使用 Broker 多窗口架构（首窗口 fork 独立进程绑定公共端口，各窗口后端随机端口注册，按 instanceId 路由）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTests.js",
    "package": "vsce package --no-git-tag-version"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.0",
    "vsce": "^2.24.0"
  }
}
